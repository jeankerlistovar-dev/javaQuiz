<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="470.0" prefWidth="500.0" spacing="15" styleClass="fondo-menu" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.javaquiz.MenuController">
    <children>
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@java.png" />
         </image>
      </ImageView>
        <Label text="Pon a prueba tus conocimientos sobre Java" textFill="ORANGE">
         <font>
            <Font name="Palatino Linotype Bold" size="16.0" />
         </font></Label>
        <Button fx:id="botonIniciar" onAction="#accionIniciar" prefHeight="35.0" prefWidth="170.0" text="Iniciar Quiz" />
        <Button onAction="#accionPuntuaciones" prefHeight="35.0" prefWidth="170.0" text="Puntuaciones" />
        <Button onAction="#accionInstrucciones" prefHeight="35.0" prefWidth="170.0" text="Instrucciones" />
        <Button onAction="#accionSalir" prefHeight="35.0" prefWidth="170.0" text="Salir" />
    </children>
</VBox>
